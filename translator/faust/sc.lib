//------------------------------------------------------------------------------
// sc.lib: hand-written Faust ports of SuperCollider UGens.
// Referenced from translator/mapping.toml; generated code imports it as `sc`.
//------------------------------------------------------------------------------
declare name "sc";
import("stdfaust.lib");

// scsynth's default block size; control-rate behaviour is defined in terms of it.
blocksize = 64;

// Control-rate semantics. A kr UGen fed by audio produces one value per block:
// krhold samples it at the block start. An audio-rate consumer that interpolates
// its kr inputs (BinaryOpUGen) ramps from the previous block's value to the
// current one across the block: kr2ar. scsynth computes the kr value from the
// whole block before the consumer runs; a causal port cannot, so krhold takes
// the value at the end of the previous block: kr paths run exactly one block late.
krhold(x) = ba.sAndH(ba.time % blocksize == 0, x@1);
a2k(x) = ba.sAndH(ba.time % blocksize == 0, x);  // A2K: first sample of each block
// At a block's first sample scsynth outputs the previous value itself (not p + 0 * slope,
// which is NaN when the new value is NaN).
// An unchanged value is output as is (K2A's next_i), so a constant -inf stays -inf.
kr2ar(x) = select2((j == 0) | (x == p), p + (x - p) * j / blocksize, p) with { j = ba.time % blocksize; p = pp(x); };
pp(x) = select2(ba.time < blocksize, x@blocksize, x);

// BinaryOpUGen 'pow': sign-preserving.
spow(a, b) = select2(a < 0, 1, -1) * pow(abs(a), b);

// Amplitude: peak follower with -20 dB attack and release times (SC uses log(0.1)).
amplitude(att, rel, x) = abs(x) : (step ~ _)
with {
    coef(t) = select2(t == 0, exp(log(0.1) / (t * ma.SR)), 0);
    step(prev, v) = select2(v < prev, v + (prev - v) * coef(att), v + (prev - v) * coef(rel));
};

// Amplitude.kr: SC computes coefficients at control rate but iterates over the
// audio block, so the effective times are divided by the block size.
// (The per-block hold is added by the code generator, as for every kr UGen.)
amplitude_kr(att, rel, x) = amplitude(att / blocksize, rel / blocksize, x);

// Amplitude.kr of a kr input: one update per block, coefficients at the control
// rate (Amplitude_next with inNumSamples = 1). Output already changes once per block.
amplitude_krkr(att, rel, x) = abs(x) : (step ~ _)
with {
    coef(t) = select2(t == 0, exp(log(0.1) / (t * ma.SR / blocksize)), 0);
    upd(prev, v) = select2(v < prev, v + (prev - v) * coef(att), v + (prev - v) * coef(rel));
    step(prev, v) = select2(ba.time % blocksize == 0, prev, upd(prev, v));
};

// MoogFF: port of server/plugins/MoogFF.cpp (Fontana 2007). Four TDF one-pole
// sections b0 (1 + z^-1) / (1 + a1 z^-1) with the delay-free feedback loop
// solved per sample. `reset` is not supported (mapping requires it to be 0).
moogff(freq, gain, x) = (step ~ (_, _, _, _)) : !, !, !, !, _
with {
    k = max(0, min(4, gain));
    wcD = max(0, 2 * tan(ma.PI * freq / ma.SR) * ma.SR);
    TwcD = wcD / ma.SR;
    b0 = TwcD / (TwcD + 2);
    a1 = (TwcD - 2) / (TwcD + 2);
    b4 = b0 * b0 * b0 * b0;
    step(s1, s2, s3, s4) = s1n, s2n, s3n, s4n, y
    with {
        o = s4 + b0 * (s3 + b0 * (s2 + b0 * s1));
        y = (b4 * x + o) / (1 + b4 * k);
        u = x - k * y;
        f1 = b0 * u + s1;
        s1n = b0 * u - a1 * f1;
        f2 = b0 * f1 + s2;
        s2n = b0 * f1 - a1 * f2;
        f3 = b0 * f2 + s3;
        s3n = b0 * f2 - a1 * f3;
        s4n = b0 * f3 - a1 * y;
    };
};

// Pitch: NOT a port. SC's Pitch is autocorrelation-based; this is Faust's
// zero-crossing tracker with SC's interface: clamped to [minFreq, maxFreq],
// voiced when the input envelope exceeds ampThreshold, last value held when
// unvoiced, initFreq until the first voiced sample. Outputs freq, hasFreq.
pitch(initFreq, minFreq, maxFreq, ampThreshold, x) = freq, hasFreq
with {
    // tau 0.05 s and 30 ms smoothing: within 50 cents of SC on the bass_di notes,
    // ~140 ms to settle (tests/cases/case_Pitch.scd, report/fidelity.md).
    raw = an.pitchTracker(4, 0.05, x) : si.smooth(ba.tau2pole(0.03)) : max(minFreq) : min(maxFreq);
    hasFreq = float(an.amp_follower_ar(0.001, 0.05, x) > ampThreshold);
    held = ba.sAndH(hasFreq > 0, raw);
    seen = hasFreq : (max ~ _);
    freq = select2(seen > 0, initFreq, held);
};

//------------------------------------------------------------------------------
// Operators (UnaryOpUGen, BinaryOpUGen), after include/plugin_interface/
// SC_InlineUnaryOp.h and SC_InlineBinaryOp.h (float32 versions).
//------------------------------------------------------------------------------
// reciprocal: scsynth uses rcp + one Newton step at both rates; 1/0 gives NaN (inf * 0).
recip(x) = select2(x == 0, 1.0 / x, copysign(1.0 / x, 1.0) - abs(1.0 / x));  // inf - inf: NaN the compiler cannot fold
ssqrt(x) = select2(x < 0, sqrt(abs(x)), 0 - sqrt(abs(x)));  // signed sqrt
softclip(x) = select2(abs(x) <= 0.5, (abs(x) - 0.25) / x, x);
inwin(x) = (x >= 0) & (x <= 1);
rectwindow(x) = float(inwin(x));
hanwindow(x) = select2(inwin(x), 0, 0.5 - 0.5 * cos(x * 2 * ma.PI));
welwindow(x) = select2(inwin(x), 0, sin(x * ma.PI));
triwindow(x) = select2(inwin(x), 0, select2(x < 0.5, -2 * x + 2, 2 * x));
ramp(x) = max(0, min(1, x));
scurve(x) = select2(x <= 0, select2(x >= 1, x * x * (3 - 2 * x), 1), 0);

// sc_mod / sc_wrap / sc_fold: hi == lo returns lo.
mod(a, hi) = select2(hi == 0, a - hi * floor(a / hi), 0);
wrap(x, lo, hi) = select2(hi == lo, x - r * floor((x - lo) / r), lo) with { r = hi - lo; };
fold(x, lo, hi) = select2(hi == lo, f, lo)
with {
    r = hi - lo;
    r2 = r + r;
    c = (x - lo) - r2 * floor((x - lo) / r2);
    f = select2(c >= r, c, r2 - c) + lo;
};
qround(x, q) = select2(q == 0, floor(x / q + 0.5) * q, x);
qroundup(x, q) = select2(q == 0, ceil(x / q) * q, x);
qtrunc(x, q) = select2(q == 0, floor(x / q) * q, x);
hypotx(a, b) = abs(a) + abs(b) - (sqrt(2) - 1) * min(abs(a), abs(b));
scaleneg(a, b) = (abs(a) - a) * (0.5 * b + 0.5) + a;
amclip(a, b) = a * 0.5 * (b + abs(b));

// sc_gcd on truncated values: Euclid unrolled to 48 steps (enough for 24-bit ints).
gcd(u, v) = select2(a == 0, select2(b == 0, g, a), b)
with {
    a = int(u);
    b = int(v);
    neg = (a <= 0) & (b <= 0);
    hi = max(abs(a), abs(b));
    lo = min(abs(a), abs(b));
    step(x, y) = select2(y > 0, x, y), select2(y > 0, 0, x % max(y, 1));
    e = (hi, lo) : seq(i, 48, step) : _, !;
    g = float(select2(neg, e, 0 - e));
};
lcm(u, v) = select2((int(u) == 0) | (int(v) == 0), float(int(u) * int(v)) / gcd(u, v), 0);

// Random operators. scsynth draws from one generator per synth; here every node
// gets its own stream (the code generator passes a distinct seed), so draws are
// independent as in scsynth, though not the same numbers.
lcg(seed) = (_ * 1103515245 + 12345 + seed * 7919 * (1 - 1')) ~ _;
urand(seed) = lcg(seed) / 4294967296.0 + 0.5;  // [0, 1)
rand(seed, x) = urand(seed) * x;
rand2(seed, x) = (2 * urand(seed) - 1) * x;
linrand(seed, x) = min(urand(seed * 4), urand(seed * 4 + 1)) * x;
bilinrand(seed, x) = (urand(seed * 4) - urand(seed * 4 + 1)) * x;
sum3rand(seed, x) = (urand(seed * 4) + urand(seed * 4 + 1) + urand(seed * 4 + 2) - 1.5) * 0.666666667 * x;
coin(seed, x) = float(urand(seed) < x);
// rrand at kr (rrand_1) draws frand, 0..1. The audio-rate variants draw frand2, -1..1,
// so their range is [2a - b, b) for a < b: rrand_ar keeps that (docs/sc-findings.md #4).
rrand(seed, a, b) = select2(b > a, b + urand(seed) * (a - b), a + urand(seed) * (b - a));
rrand_ar(seed, a, b) = select2(b > a, b + (2 * urand(seed) - 1) * (a - b), a + (2 * urand(seed) - 1) * (b - a));
exprand(seed, a, b) = lo * exp(log(hi / lo) * urand(seed)) with { lo = min(a, b); hi = max(a, b); };

//------------------------------------------------------------------------------
// nova-simd math (external_libraries/nova-simd/detail/vec_math.hpp, SSE float).
// scsynth uses these for audio-rate UnaryOpUGens when the block size is a multiple
// of 16 (UnaryOpUGens.cpp ChooseOperatorFunc); kr operators use the C library.
// Polynomials and constants are copied; bit-level frexp/ldexp are emulated.
//------------------------------------------------------------------------------
copysign = ffunction(float copysignf|copysign|copysignl (float, float), <math.h>, "");
nsgn(x) = copysign(1.0, x);  // sign bit, including -0.0
// frexp_float: x = m * 2^e, |m| in [0.5, 1), sign kept on m; zero (and denormals) give
// m = ±0.5, e = -126, as the bit manipulation does.
nfrexp_e(x) = select2(abs(x) >= ma.MIN, -126, E + 1)
with {
    ax = abs(x);
    E0 = floor(log(ax) / log(2.0));
    p = pow(2.0, E0);
    E = E0 - (ax < p) + (ax >= 2 * p);
};
nfrexp_m(x) = nsgn(x) * select2(abs(x) >= ma.MIN, 0.5, abs(x) / pow(2.0, nfrexp_e(x)));

nlog(arg) = z + 0.693359375 * fe
with {
    m = nfrexp_m(arg);
    small = m < 0.707106781186547524;
    fe = float(nfrexp_e(arg) - small);
    x = select2(small, m - 1, m + m - 1);
    y0 = ((((((((7.0376836292e-2 * x - 1.1514610310e-1) * x + 1.1676998740e-1) * x - 1.2420140846e-1) * x
          + 1.4249322787e-1) * x - 1.6668057665e-1) * x + 2.0000714765e-1) * x - 2.4999993993e-1) * x
          + 3.3333331174e-1) * x * x * x;
    y = y0 + fe * -2.12194440e-4 - 0.5 * x * x;
    z = x + y;
};
nlog2(x) = nlog(x) * 1.4426950408889634;
nlog10(x) = nlog(x) * 0.4342944819032518;

nexp_nb(arg) = p * pow(2.0, z)  // without boundary checks (vec_exp_tanh_float)
with {
    z = rint(1.44269504088896341 * arg);
    x = (arg - z * 0.693359375) - z * -2.12194440e-4;
    p = 1 + x * (1.00000035762786865234375 + x * (0.4999996721744537353515625 + x * (0.16665561497211456298828125
        + x * (4.167006909847259521484375e-2 + x * (8.420792408287525177001953125e-3 + x * 1.386119984090328216552734375e-3)))));
};
nexp(arg) = select2(arg < -88.0, select2(arg > 88.72283905206835, nexp_nb(arg), ma.MAX), 0);
npow(a, b) = select2(a == 0, nexp(b * nlog(a)), 0);
nspow(a, b) = nsgn(a) * npow(abs(a), b);  // spow_vec_simd: BinaryOpUGen pow at audio rate

// shared argument reduction of sin, cos, tan
nquad(arg) = (int(abs(arg) * 1.27323954473516268615107010698011489627567716592367) + 1) & (0 - 2);
nbase(arg) = ((abs(arg) - y * 0.78515625) - y * 2.4187564849853515625e-4) - y * 3.77489497744594108e-8
with { y = float(nquad(arg)); };
npc(b) = ((2.443315711809948e-005 * z - 1.388731625493765e-003) * z + 4.166664568298827e-002) * z * z - 0.5 * z + 1.0
with { z = b * b; };
nps(b) = ((-1.9515295891e-4 * z + 8.3321608736e-3) * z - 1.6666654611e-1) * z * b + b with { z = b * b; };

nsin(arg) = select2((j & 2) == 0, npc(b), nps(b)) * nsgn(arg) * select2((j & 4) != 0, 1, -1)
with { j = nquad(arg); b = nbase(arg); };
ncos(arg) = select2((jm2 & 2) == 0, npc(b), nps(b)) * select2((jm2 & 4) == 0, 1, -1)
with { jm2 = nquad(arg) - 2; b = nbase(arg); };
ntan(arg) = select2((nquad(arg) & 2) == 0, -1.0 / approx, approx) * nsgn(arg)
with {
    x = nbase(arg);
    x2 = x * x;
    approx = x + x * x2 * (0.3333315551280975341796875 + x2 * (0.1333882510662078857421875 + x2 * (5.3409568965435028076171875e-2
             + x2 * (2.443529665470123291015625e-2 + x2 * (3.1127030961215496063232421875e-3 + x2 * 9.3892104923725128173828125e-3)))));
};

nasin(arg) = select2(a > 1, approx, 0)  // |arg| > 1 gives 0, not NaN
with {
    a = abs(arg);
    gt = a > 0.5;
    x = select2(gt, a, sqrt((1 - a) * 0.5));
    x2 = x * x;
    p = x + x * x2 * (0.166667520999908447265625 + x2 * (7.4953101575374603271484375e-2 + x2 * (4.54690195620059967041015625e-2
        + x2 * (2.418550290167331695556640625e-2 + x2 * 4.21570129692554473876953125e-2))));
    approx = select2(gt, p, 1.57079637050628662109375 - p - p) * nsgn(arg);
};
nacos(arg) = select2(abs(arg) > 1, r, 0)
with {
    as = nasin(select2(abs(arg) > 0.5, arg, sqrt((1 - abs(arg)) * 0.5)));
    r = select2(arg > -0.5, 3.1415927410125732421875 - as - as, select2(arg > 0.5, 1.57079637050628662109375 - as, as + as));
};
natan(arg) = (off + x + x * x2 * (-0.333329498767852783203125 + x2 * (0.19977732002735137939453125
             + x2 * (-0.1387787759304046630859375 + x2 * 8.054284751415252685546875e-2)))) * nsgn(arg)
with {
    a = abs(arg);
    m01 = a > 0.41421356237309504880168872420969807856967187537695;
    m12 = a > 2.41421356237309504880168872420969807856967187537698;
    x = select2(m01, a, select2(m12, (a - 1) / (a + 1), -1 / a));
    off = select2(m01, 0, select2(m12, 0.78539816339744830961566084581987572104929234984377, 1.57079632679489661923132169163975144209858469968754));
    x2 = x * x;
};
ntanh(arg) = select2(a < 0.625, select2(a > 22, 1 - 2 / (nexp_nb(a + a) + 1), 1) * nsgn(arg), small)
with {
    a = abs(arg);
    s = a * a;
    small = ((((-5.70498872745e-3 * s + 2.06390887954e-2) * s - 5.37397155531e-2) * s + 1.33314422036e-1) * s
            - 3.33332819422e-1) * s * arg + arg;
};
