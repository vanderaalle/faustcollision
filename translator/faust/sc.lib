//------------------------------------------------------------------------------
// sc.lib: hand-written Faust ports of SuperCollider UGens.
// Referenced from translator/mapping.toml; generated code imports it as `sc`.
//------------------------------------------------------------------------------
declare name "sc";
import("stdfaust.lib");

// scsynth's default block size; control-rate behaviour is defined in terms of it.
blocksize = 64;

// Control-rate semantics. A kr UGen fed by audio produces one value per block:
// krhold samples it at the block start. An audio-rate consumer that interpolates
// its kr inputs (BinaryOpUGen) ramps from the previous block's value to the
// current one across the block: kr2ar. scsynth computes the kr value from the
// whole block before the consumer runs; a causal port cannot, so krhold takes
// the value at the end of the previous block: kr paths run exactly one block late.
krhold(x) = ba.sAndH(ba.time % blocksize == 0, x@1);
a2k(x) = ba.sAndH(ba.time % blocksize == 0, x);  // A2K: first sample of each block
// At a block's first sample scsynth outputs the previous value itself (not p + 0 * slope,
// which is NaN when the new value is NaN).
// An unchanged value is output as is (K2A's next_i), so a constant -inf stays -inf.
kr2ar(x) = select2((j == 0) | (x == p), p + (x - p) * j / blocksize, p) with { j = ba.time % blocksize; p = pp(x); };
pp(x) = select2(ba.time < blocksize, x@blocksize, x);

// BinaryOpUGen 'pow': sign-preserving.
spow(a, b) = select2(a < 0, 1, -1) * pow(abs(a), b);

// Amplitude: peak follower with -20 dB attack and release times (SC uses log(0.1)).
amplitude(att, rel, x) = abs(x) : (step ~ _)
with {
    coef(t) = select2(t == 0, exp(log(0.1) / (t * ma.SR)), 0);
    step(prev, v) = select2(v < prev, v + (prev - v) * coef(att), v + (prev - v) * coef(rel));
};

// Amplitude.kr: SC computes coefficients at control rate but iterates over the
// audio block, so the effective times are divided by the block size.
// (The per-block hold is added by the code generator, as for every kr UGen.)
amplitude_kr(att, rel, x) = amplitude(att / blocksize, rel / blocksize, x);

// Amplitude.kr of a kr input: one update per block, coefficients at the control
// rate (Amplitude_next with inNumSamples = 1). Output already changes once per block.
amplitude_krkr(att, rel, x) = abs(x) : (step ~ _)
with {
    coef(t) = select2(t == 0, exp(log(0.1) / (t * ma.SR / blocksize)), 0);
    upd(prev, v) = select2(v < prev, v + (prev - v) * coef(att), v + (prev - v) * coef(rel));
    step(prev, v) = select2(ba.time % blocksize == 0, prev, upd(prev, v));
};

// MoogFF: port of server/plugins/MoogFF.cpp (Fontana 2007). Four TDF one-pole
// sections b0 (1 + z^-1) / (1 + a1 z^-1) with the delay-free feedback loop
// solved per sample. `reset` is not supported (mapping requires it to be 0).
moogff(freq, gain, x) = (step ~ (_, _, _, _)) : !, !, !, !, _
with {
    k = max(0, min(4, gain));
    wcD = max(0, 2 * tan(ma.PI * freq / ma.SR) * ma.SR);
    TwcD = wcD / ma.SR;
    b0 = TwcD / (TwcD + 2);
    a1 = (TwcD - 2) / (TwcD + 2);
    b4 = b0 * b0 * b0 * b0;
    step(s1, s2, s3, s4) = s1n, s2n, s3n, s4n, y
    with {
        o = s4 + b0 * (s3 + b0 * (s2 + b0 * s1));
        y = (b4 * x + o) / (1 + b4 * k);
        u = x - k * y;
        f1 = b0 * u + s1;
        s1n = b0 * u - a1 * f1;
        f2 = b0 * f1 + s2;
        s2n = b0 * f1 - a1 * f2;
        f3 = b0 * f2 + s3;
        s3n = b0 * f2 - a1 * f3;
        s4n = b0 * f3 - a1 * y;
    };
};

// Pitch: NOT a port. SC's Pitch is autocorrelation-based; this is Faust's
// zero-crossing tracker with SC's interface: clamped to [minFreq, maxFreq],
// voiced when the input envelope exceeds ampThreshold, last value held when
// unvoiced, initFreq until the first voiced sample. Outputs freq, hasFreq.
pitch(initFreq, minFreq, maxFreq, ampThreshold, x) = freq, hasFreq
with {
    // tau 0.05 s and 30 ms smoothing: within 50 cents of SC on the bass_di notes,
    // ~140 ms to settle (tests/cases/case_Pitch.scd, report/fidelity.md).
    raw = an.pitchTracker(4, 0.05, x) : si.smooth(ba.tau2pole(0.03)) : max(minFreq) : min(maxFreq);
    hasFreq = float(an.amp_follower_ar(0.001, 0.05, x) > ampThreshold);
    held = ba.sAndH(hasFreq > 0, raw);
    seen = hasFreq : (max ~ _);
    freq = select2(seen > 0, initFreq, held);
};

//------------------------------------------------------------------------------
// Operators (UnaryOpUGen, BinaryOpUGen), after include/plugin_interface/
// SC_InlineUnaryOp.h and SC_InlineBinaryOp.h (float32 versions).
//------------------------------------------------------------------------------
// reciprocal: scsynth uses rcp + one Newton step at both rates; 1/0 gives NaN (inf * 0).
recip(x) = select2(x == 0, 1.0 / x, copysign(1.0 / x, 1.0) - abs(1.0 / x));  // inf - inf: NaN the compiler cannot fold
ssqrt(x) = select2(x < 0, sqrt(abs(x)), 0 - sqrt(abs(x)));  // signed sqrt
softclip(x) = select2(abs(x) <= 0.5, (abs(x) - 0.25) / x, x);
inwin(x) = (x >= 0) & (x <= 1);
rectwindow(x) = float(inwin(x));
hanwindow(x) = select2(inwin(x), 0, 0.5 - 0.5 * cos(x * 2 * ma.PI));
welwindow(x) = select2(inwin(x), 0, sin(x * ma.PI));
triwindow(x) = select2(inwin(x), 0, select2(x < 0.5, -2 * x + 2, 2 * x));
ramp(x) = max(0, min(1, x));
scurve(x) = select2(x <= 0, select2(x >= 1, x * x * (3 - 2 * x), 1), 0);

// sc_mod / sc_wrap / sc_fold: hi == lo returns lo.
mod(a, hi) = select2(hi == 0, a - hi * floor(a / hi), 0);
wrap(x, lo, hi) = select2(hi == lo, x - r * floor((x - lo) / r), lo) with { r = hi - lo; };
fold(x, lo, hi) = select2(hi == lo, f, lo)
with {
    r = hi - lo;
    r2 = r + r;
    c = (x - lo) - r2 * floor((x - lo) / r2);
    f = select2(c >= r, c, r2 - c) + lo;
};
qround(x, q) = select2(q == 0, floor(x / q + 0.5) * q, x);
qroundup(x, q) = select2(q == 0, ceil(x / q) * q, x);
qtrunc(x, q) = select2(q == 0, floor(x / q) * q, x);
hypotx(a, b) = abs(a) + abs(b) - (sqrt(2) - 1) * min(abs(a), abs(b));
scaleneg(a, b) = (abs(a) - a) * (0.5 * b + 0.5) + a;
amclip(a, b) = a * 0.5 * (b + abs(b));

// sc_gcd on truncated values: Euclid unrolled to 48 steps (enough for 24-bit ints).
gcd(u, v) = select2(a == 0, select2(b == 0, g, a), b)
with {
    a = int(u);
    b = int(v);
    neg = (a <= 0) & (b <= 0);
    hi = max(abs(a), abs(b));
    lo = min(abs(a), abs(b));
    step(x, y) = select2(y > 0, x, y), select2(y > 0, 0, x % max(y, 1));
    e = (hi, lo) : seq(i, 48, step) : _, !;
    g = float(select2(neg, e, 0 - e));
};
lcm(u, v) = select2((int(u) == 0) | (int(v) == 0), float(int(u) * int(v)) / gcd(u, v), 0);

// Random operators. scsynth draws from one generator per synth; here every node
// gets its own stream (the code generator passes a distinct seed), so draws are
// independent as in scsynth, though not the same numbers.
lcg(seed) = (_ * 1103515245 + 12345 + seed * 7919 * (1 - 1')) ~ _;
urand(seed) = lcg(seed) / 4294967296.0 + 0.5;  // [0, 1)
rand(seed, x) = urand(seed) * x;
rand2(seed, x) = (2 * urand(seed) - 1) * x;
linrand(seed, x) = min(urand(seed * 4), urand(seed * 4 + 1)) * x;
bilinrand(seed, x) = (urand(seed * 4) - urand(seed * 4 + 1)) * x;
sum3rand(seed, x) = (urand(seed * 4) + urand(seed * 4 + 1) + urand(seed * 4 + 2) - 1.5) * 0.666666667 * x;
coin(seed, x) = float(urand(seed) < x);
// rrand at kr (rrand_1) draws frand, 0..1. The audio-rate variants draw frand2, -1..1,
// so their range is [2a - b, b) for a < b: rrand_ar keeps that (docs/sc-findings.md #4).
rrand(seed, a, b) = select2(b > a, b + urand(seed) * (a - b), a + urand(seed) * (b - a));
rrand_ar(seed, a, b) = select2(b > a, b + (2 * urand(seed) - 1) * (a - b), a + (2 * urand(seed) - 1) * (b - a));
exprand(seed, a, b) = lo * exp(log(hi / lo) * urand(seed)) with { lo = min(a, b); hi = max(a, b); };

//------------------------------------------------------------------------------
// nova-simd math (external_libraries/nova-simd/detail/vec_math.hpp, SSE float).
// scsynth uses these for audio-rate UnaryOpUGens when the block size is a multiple
// of 16 (UnaryOpUGens.cpp ChooseOperatorFunc); kr operators use the C library.
// Polynomials and constants are copied; bit-level frexp/ldexp are emulated.
//------------------------------------------------------------------------------
copysign = ffunction(float copysignf|copysign|copysignl (float, float), <math.h>, "");
nsgn(x) = copysign(1.0, x);  // sign bit, including -0.0
// frexp_float: x = m * 2^e, |m| in [0.5, 1), sign kept on m; zero (and denormals) give
// m = ±0.5, e = -126, as the bit manipulation does.
nfrexp_e(x) = select2(abs(x) >= ma.MIN, -126, E + 1)
with {
    ax = abs(x);
    E0 = floor(log(ax) / log(2.0));
    p = pow(2.0, E0);
    E = E0 - (ax < p) + (ax >= 2 * p);
};
nfrexp_m(x) = nsgn(x) * select2(abs(x) >= ma.MIN, 0.5, abs(x) / pow(2.0, nfrexp_e(x)));

nlog(arg) = z + 0.693359375 * fe
with {
    m = nfrexp_m(arg);
    small = m < 0.707106781186547524;
    fe = float(nfrexp_e(arg) - small);
    x = select2(small, m - 1, m + m - 1);
    y0 = ((((((((7.0376836292e-2 * x - 1.1514610310e-1) * x + 1.1676998740e-1) * x - 1.2420140846e-1) * x
          + 1.4249322787e-1) * x - 1.6668057665e-1) * x + 2.0000714765e-1) * x - 2.4999993993e-1) * x
          + 3.3333331174e-1) * x * x * x;
    y = y0 + fe * -2.12194440e-4 - 0.5 * x * x;
    z = x + y;
};
nlog2(x) = nlog(x) * 1.4426950408889634;
nlog10(x) = nlog(x) * 0.4342944819032518;

nexp_nb(arg) = p * pow(2.0, z)  // without boundary checks (vec_exp_tanh_float)
with {
    z = rint(1.44269504088896341 * arg);
    x = (arg - z * 0.693359375) - z * -2.12194440e-4;
    p = 1 + x * (1.00000035762786865234375 + x * (0.4999996721744537353515625 + x * (0.16665561497211456298828125
        + x * (4.167006909847259521484375e-2 + x * (8.420792408287525177001953125e-3 + x * 1.386119984090328216552734375e-3)))));
};
nexp(arg) = select2(arg < -88.0, select2(arg > 88.72283905206835, nexp_nb(arg), ma.MAX), 0);
npow(a, b) = select2(a == 0, nexp(b * nlog(a)), 0);
nspow(a, b) = nsgn(a) * npow(abs(a), b);  // spow_vec_simd: BinaryOpUGen pow at audio rate

// shared argument reduction of sin, cos, tan
nquad(arg) = (int(abs(arg) * 1.27323954473516268615107010698011489627567716592367) + 1) & (0 - 2);
nbase(arg) = ((abs(arg) - y * 0.78515625) - y * 2.4187564849853515625e-4) - y * 3.77489497744594108e-8
with { y = float(nquad(arg)); };
npc(b) = ((2.443315711809948e-005 * z - 1.388731625493765e-003) * z + 4.166664568298827e-002) * z * z - 0.5 * z + 1.0
with { z = b * b; };
nps(b) = ((-1.9515295891e-4 * z + 8.3321608736e-3) * z - 1.6666654611e-1) * z * b + b with { z = b * b; };

nsin(arg) = select2((j & 2) == 0, npc(b), nps(b)) * nsgn(arg) * select2((j & 4) != 0, 1, -1)
with { j = nquad(arg); b = nbase(arg); };
ncos(arg) = select2((jm2 & 2) == 0, npc(b), nps(b)) * select2((jm2 & 4) == 0, 1, -1)
with { jm2 = nquad(arg) - 2; b = nbase(arg); };
ntan(arg) = select2((nquad(arg) & 2) == 0, -1.0 / approx, approx) * nsgn(arg)
with {
    x = nbase(arg);
    x2 = x * x;
    approx = x + x * x2 * (0.3333315551280975341796875 + x2 * (0.1333882510662078857421875 + x2 * (5.3409568965435028076171875e-2
             + x2 * (2.443529665470123291015625e-2 + x2 * (3.1127030961215496063232421875e-3 + x2 * 9.3892104923725128173828125e-3)))));
};

nasin(arg) = select2(a > 1, approx, 0)  // |arg| > 1 gives 0, not NaN
with {
    a = abs(arg);
    gt = a > 0.5;
    x = select2(gt, a, sqrt((1 - a) * 0.5));
    x2 = x * x;
    p = x + x * x2 * (0.166667520999908447265625 + x2 * (7.4953101575374603271484375e-2 + x2 * (4.54690195620059967041015625e-2
        + x2 * (2.418550290167331695556640625e-2 + x2 * 4.21570129692554473876953125e-2))));
    approx = select2(gt, p, 1.57079637050628662109375 - p - p) * nsgn(arg);
};
nacos(arg) = select2(abs(arg) > 1, r, 0)
with {
    as = nasin(select2(abs(arg) > 0.5, arg, sqrt((1 - abs(arg)) * 0.5)));
    r = select2(arg > -0.5, 3.1415927410125732421875 - as - as, select2(arg > 0.5, 1.57079637050628662109375 - as, as + as));
};
natan(arg) = (off + x + x * x2 * (-0.333329498767852783203125 + x2 * (0.19977732002735137939453125
             + x2 * (-0.1387787759304046630859375 + x2 * 8.054284751415252685546875e-2)))) * nsgn(arg)
with {
    a = abs(arg);
    m01 = a > 0.41421356237309504880168872420969807856967187537695;
    m12 = a > 2.41421356237309504880168872420969807856967187537698;
    x = select2(m01, a, select2(m12, (a - 1) / (a + 1), -1 / a));
    off = select2(m01, 0, select2(m12, 0.78539816339744830961566084581987572104929234984377, 1.57079632679489661923132169163975144209858469968754));
    x2 = x * x;
};
ntanh(arg) = select2(a < 0.625, select2(a > 22, 1 - 2 / (nexp_nb(a + a) + 1), 1) * nsgn(arg), small)
with {
    a = abs(arg);
    s = a * a;
    small = ((((-5.70498872745e-3 * s + 2.06390887954e-2) * s - 5.37397155531e-2) * s + 1.33314422036e-1) * s
            - 3.33332819422e-1) * s * arg + arg;
};

//------------------------------------------------------------------------------
// Table oscillators (server/plugins/OscUGens.cpp, include/plugin_interface/SC_SndBuf.h).
// 32-bit integer phase, 16 fractional bits; the 8192-point sine is stored in
// "wavetable" form (common/Samp.cpp SignalAsWavetable) and read by lookupi1.
//------------------------------------------------------------------------------
sinesize = 8192;
sine(i) = sin(float(i) * (2.0 * ma.PI / sinesize));
sinew0(i) = rdtable(sinesize, 2.0 * sine(ba.time) - sine(ba.time + 1), i);
sinew1(i) = rdtable(sinesize, sine(ba.time + 1) - sine(ba.time), i);
lookupi1(phase) = sinew0(i) + sinew1(i) * (1.0 + float(phase & 65535) / 65536.0)
with { i = (phase >> 16) & (sinesize - 1); };

// floor(A * 2^s / d) for ints A >= 0, d > 0, 0 <= s <= 40: binary long division.
// (Faust's / returns a float even for ints: the first quotient, exact below 2^24, is cast back.)
ldiv(A, s, d) = int((A - A % d) / d), A % d : seq(i, 40, step(i)) : _, !
with {
    step(i, q, r) = select2(i < s, q, 2 * q + b), select2(i < s, r, r2 - b * d)
    with { r2 = 2 * r; b = r2 >= d; };
};
// (int32)(double(2^shift / SR) * f): the exact phase increment scsynth computes in double
// (Osc_ikk_perform). f = A * 2^(e-24) with A a 24-bit integer.
dinc(f, shift) = int(nsgn(f)) * select2(s >= 0, select2(s < -24, ldiv(A >> (0 - s), 0, sr), 0), ldiv(A, s, sr))
with {
    e = nfrexp_e(f);
    A = int(abs(nfrexp_m(f)) * 16777216.0);
    s = e - 24 + shift;
    sr = int(ma.SR);
};
radtoinc = sinesize * 65536.0 / (2.0 * ma.PI);
iphase(inc) = (+(inc) ~ _) : mem;  // sum of increments before this sample, wrapping like int32

// SinOsc. _d: constant/kr frequency (double product); _f: audio-rate frequency (float product).
sinosc_d(freq, phase) = lookupi1(iphase(int(dinc(freq, 29))) + int(radtoinc * phase));
sinosc_f(freq, phase) = lookupi1(iphase(int(float(536870912.0 / ma.SR) * freq)) + int(radtoinc * phase));
// SinOsc.kr: one step per block of the control-rate phase (SAMPLEDUR = blocksize / SR).
sinosc_kr(freq, phase) = lookupi1(kphase + int(radtoinc * phase))
with { kphase = (+(int(dinc(freq, 35)) * (ba.time % blocksize == 0)) ~ _) : mem; };

//------------------------------------------------------------------------------
// Double-precision phase as a float pair (hi, lo), |lo| <= ulp(hi)/2.
// LF oscillators keep their phase in a double (LFUGens.cpp); a float phase drifts
// enough over seconds to move wrap points by a sample. Additions go through
// fmaf(a, 1, b) (= a + b, one rounding) so the Faust compiler cannot simplify
// the error terms away.
//------------------------------------------------------------------------------
fmaf = ffunction(float fmaf|fma|fmal (float, float, float), <math.h>, "");
fadd(a, b) = fmaf(a, 1.0, b);
fsub(a, b) = fmaf(b, -1.0, a);
// (hi, lo) + x  (TwoSum, then renormalise)
dadd(hi, lo, x) = h2, fsub(t, fsub(h2, s))
with {
    s = fadd(hi, x);
    bb = fsub(s, hi);
    t = fadd(fadd(fsub(hi, fsub(s, bb)), fsub(x, bb)), lo);
    h2 = fadd(s, t);
};
// (hi, lo) - c for a constant c close to hi (exact on hi by Sterbenz), renormalised
dsubc(hi, lo, c) = h2, fsub(lo, fsub(h2, h)) with { h = fsub(hi, c); h2 = fadd(h, lo); };
dge(hi, lo, c) = (hi > c) | ((hi == c) & (lo >= 0));
dgt(hi, lo, c) = (hi > c) | ((hi == c) & (lo > 0));
dle(hi, lo, c) = (hi < c) | ((hi == c) & (lo <= 0));
dlt(hi, lo, c) = (hi < c) | ((hi == c) & (lo < 0));
dval(hi, lo) = fadd(hi, lo);  // (float)phase
// select between two pairs
dsel(c, h0, l0, h1, l1) = select2(c, h0, h1), select2(c, l0, l1);

// Box forms, so each sub-expression is built once (selecting outputs of a
// multi-output expression repeatedly makes the compiler re-expand it).
daddB(x) = \(h, l).(dadd(h, l, x));            // (h, l) -> (h, l) + x
dsubcB(c) = \(h, l).(dsubc(h, l, c));          // (h, l) -> (h, l) - c
dselB = \(c, h0, l0, h1, l1).(select2(c, h0, h1), select2(c, l0, l1));
cwrap(test, c) = _, _ <: test, (_, _), dsubcB(c) : dselB;   // subtract c where test(h, l)
// if test1: - c1, elif test2: - c2 (both tests on the same value)
cwrap2(t1, c1, t2, c2) = _, _ <: t1, t2, (_, _), dsubcB(c1), dsubcB(c2)
    : \(a, b, h, l, h1, l1, h2, l2).(select2(a, select2(b, h, h2), h1), select2(a, select2(b, l, l2), l1));

// One LF oscillator. stepB: (hi, lo) -> (z, hi', lo'), one iteration of the scsynth
// loop. The constructor runs one iteration and keeps the phase (LF*_Ctor calls
// next_k(unit, 1)), so sample 0 is iteration two. clk: 1 where the oscillator
// steps (every sample at ar, block starts at kr).
lfosc_clk(stepB, iphase, clk) = (core ~ (_, _)) : !, !, _
with {
    init = (iphase, 0.0) : stepB : !, _, _;
    first = ba.time == 0;
    core = (_, _, init) : \(hf, lf, h0, l0).(select2(first, hf, h0), select2(first, lf, l0))
         : (_, _ <: (_, _), stepB)
         : \(h, l, z, h2, l2).(select2(clk, h, h2), select2(clk, l, l2), z);
};
krclk = ba.time % blocksize == 0;
lfosc(stepB, iphase) = lfosc_clk(stepB, iphase, 1);
lfosc_kr(stepB, iphase) = lfosc_clk(stepB, iphase, krclk);

// LFSaw: output the phase, step, wrap. next_k wraps by the sign of freq; next_a both ways.
lfsaw_kB(inc) = _, _ <: dval, (daddB(inc) : cwrap(\(h, l).((inc >= 0) & dge(h, l, 1.0)), 2.0)
                                         : cwrap(\(h, l).((inc < 0) & dle(h, l, -1.0)), -2.0));
lfsaw_aB(inc) = _, _ <: dval, (daddB(inc) : cwrap2(\(h, l).(dge(h, l, 1.0)), 2.0, \(h, l).(dle(h, l, -1.0)), -2.0));
lfsaw(freq, iphase) = lfosc(lfsaw_kB(freq * float(2.0 / ma.SR)), iphase);
lfsaw_ar(freq, iphase) = lfosc(lfsaw_aB(freq * float(2.0 / ma.SR)), iphase);
lfsaw_kr(freq, iphase) = lfosc_kr(lfsaw_kB(freq * float(2.0 * blocksize / ma.SR)), iphase);

// LFTri: z = phase > 1 ? 2 - phase : phase; step; wrap at 3 by -4.
lftriB(inc) = _, _ <: \(h, l).(select2(dgt(h, l, 1.0), dval(h, l), fadd(fsub(2.0, h), 0.0 - l))),
                      (daddB(inc) : cwrap(\(h, l).(dge(h, l, 3.0)), 4.0));
lftri(freq, iphase) = lfosc(lftriB(freq * float(4.0 / ma.SR)), iphase);
lftri_kr(freq, iphase) = lfosc_kr(lftriB(freq * float(4.0 * blocksize / ma.SR)), iphase);

// LFPar: pre-wrap at 3 by -4; 1 - z^2 below 1, (z - 2)^2 - 1 above; then step.
sq(z) = z * z;
lfparB(inc) = cwrap(\(h, l).(dge(h, l, 3.0)), 4.0)
    : _, _ <: \(h, l).(select2(dlt(h, l, 1.0), sq(fadd(fsub(h, 2.0), l)) - 1.0, 1.0 - sq(dval(h, l)))), daddB(inc);
lfpar(freq, iphase) = lfosc(lfparB(freq * float(4.0 / ma.SR)), iphase);
lfpar_kr(freq, iphase) = lfosc_kr(lfparB(freq * float(4.0 * blocksize / ma.SR)), iphase);

// LFCub: phase starts at iphase + 0.5; pre-wrap at 2 by -2; z = phase or 2 - phase;
// z * z * (6 - 4z) - 1; then step.
cub(z) = z * z * (6.0 - 4.0 * z) - 1.0;
lfcubB(inc) = cwrap(\(h, l).(dge(h, l, 2.0)), 2.0)
    : _, _ <: \(h, l).(cub(select2(dlt(h, l, 1.0), fadd(fsub(2.0, h), 0.0 - l), dval(h, l)))), daddB(inc);
lfcub(freq, iphase) = lfosc(lfcubB(freq * float(2.0 / ma.SR)), iphase + 0.5);
lfcub_kr(freq, iphase) = lfosc_kr(lfcubB(freq * float(2.0 * blocksize / ma.SR)), iphase + 0.5);

// LFPulse: pre-wrap at 1 taking the new duty (and outputting at least one sample of
// the opposite polarity), else z = phase < duty; then step. State: phase pair, duty.
lfpulse_clk(inc, iphase, width, clk) = (core ~ (_, _, _)) : !, !, !, _
with {
    stepB = _, _, _ <: (\(h, l, d).(dge(h, l, 1.0))), (_, _, _)
          : \(w, h, l, d).(w, w, h, l, h, l, d)
          : (_, (_, _, _, dsubcB(1.0) : dselB), _)
          : \(w, ph, pl, d).(w, ph, pl, select2(w, d, width))
          : \(w, ph, pl, d2).(select2(w, float(dlt(ph, pl, d2)), float(d2 <= 0.5)), ph, pl, d2)
          : (_, daddB(inc), _);
    init = (iphase, 0.0, width) : stepB : !, _, _, _;
    first = ba.time == 0;
    core = (_, _, _, init) : \(hf, lf, df, h0, l0, d0).(select2(first, hf, h0), select2(first, lf, l0), select2(first, df, d0))
         : (_, _, _ <: (_, _, _), stepB)
         : \(h, l, d, z, h2, l2, d2).(select2(clk, h, h2), select2(clk, l, l2), select2(clk, d, d2), z);
};
lfpulse(freq, iphase, width) = lfpulse_clk(freq * float(1.0 / ma.SR), iphase, width, 1);
lfpulse_kr(freq, iphase, width) = lfpulse_clk(freq * float(blocksize / ma.SR), iphase, width, krclk);

phi(p) = p : _, !;  // components of a (hi, lo) pair expression
plo(p) = p : !, _;

// Impulse (LFUGens.cpp, 3.13): double phase, impulse when it wraps. The wrap test uses
// the sign of the previous increment; a constructor sample is computed but the phase is
// reset, so there is no extra step. Phase offset: constant only (mapping requires it).
// inc: the increment added at each sample (audio: freq[n] / SR; kr freq: ramped across
// the block to the new value, Impulse_next_ki); clk as for lfosc.
impulse_core(inc, off, clk) = (core ~ (_, _)) : !, !, _
with {
    i0 = select2(ba.time == 0, inc@1, inc);      // increment of the previous sample
    w = dadd(off, 0.0, 0.0 - floor(off));         // sc_wrap(off, 0, 1), exact
    zero0 = (phi(w) == 0) & (plo(w) == 0) & (inc >= 0);
    h0 = select2(zero0, select2(phi(w) == 1.0, phi(w), 0.0), 1.0);
    l0 = select2(zero0 | (phi(w) == 1.0), plo(w), 0.0);
    // (prevInc, h, l) -> (z, h', l'): Impulse_testWrapPhase, then phase += inc
    testB = \(pi, h, l).(
        select2(pi < 0, float(dge(h, l, 1.0)), float(dle(h, l, 0.0))),
        select2(pi < 0, select2(dge(h, l, 1.0), h, fsub(h, 1.0) - floor(fsub(h, 1.0) * float(fsub(h, 1.0) >= 1.0))),
                         select2(dle(h, l, 0.0), h, fadd(h, 1.0) - ceil(fadd(h, 1.0) * float(fadd(h, 1.0) <= 0.0)))),
        l);
    core = (_, _) : \(hf, lf).(i0, select2(ba.time == 0, hf, h0), select2(ba.time == 0, lf, l0))
         : (_, _, _ <: !, _, _, testB)
         : \(h, l, z, h2, l2).(select2(clk, h, phi(dadd(h2, l2, inc))), select2(clk, l, plo(dadd(h2, l2, inc))), z * clk);
};
impulse_ar(freq, off) = impulse_core(freq * float(1.0 / ma.SR), off, 1);
// kr freq: per block, ramp from the previous block's increment to the new one (double slope)
impulse(freq, off) = impulse_core(r, off, 1)
with {
    j = ba.time % blocksize;
    t = freq * float(1.0 / ma.SR);
    p = select2(ba.time < blocksize, ba.sAndH(j == 0, t)@blocksize, t);
    c = ba.sAndH(j == 0, t);
    r = p + (c - p) * float(j + 1) / blocksize;
};
impulse_kr(freq, off) = impulse_core(freq * float(blocksize / ma.SR), off, krclk);

//------------------------------------------------------------------------------
// Noise (server/plugins/NoiseUGens.cpp). scsynth's generator (taus88, SC_RGen.h) is
// seeded per server, so only distributions can be compared. These ports use
// xorshift32 per node (seeded by the code generator) and the same bit-to-float
// conversions as RGen: frand 0..1, frand2 -1..1, frand8 -0.125..0.125, fcoin ±1.
//------------------------------------------------------------------------------
lsr(x, k) = (x >> k) & ((1 << (32 - k)) - 1);   // logical shift right on int32
xorshift(x) = x3 with { x1 = x xor (x << 13); x2 = x1 xor lsr(x1, 17); x3 = x2 xor (x2 << 5); };
// a stream of 32-bit words, one per sample, independent per seed
trand(seed) = (\(fb).(xorshift(select2(ba.time == 0, fb, s0))) ~ _)
with { s0 = int(seed) * 747796405 + 2891336453; };
frand(seed) = float(lsr(trand(seed), 9)) / 8388608.0;
frand2(seed) = float(lsr(trand(seed), 9)) / 4194304.0 - 1.0;
frand8(seed) = float(lsr(trand(seed), 9)) / 33554432.0 - 0.125;
fcoin(seed) = select2(trand(seed) < 0, 1.0, -1.0);

// A state machine of N state variables. stepB: N states -> (out, N states), one sample of
// the scsynth loop; initB: the constructor's initial state (N signals, read at time 0).
// ctor = 1 when the constructor runs one iteration before the first block.
// clk: 1 where it steps (every sample at ar, block starts at kr).
machine(N, stepB, initB, ctor, clk) = (core ~ si.bus(N)) : (si.block(N), _)
with {
    first = ba.time == 0;
    init = initB <: si.bus(N), (stepB : !, si.bus(N)) : ro.interleave(N, 2) : par(i, N, select2(ctor));
    core = (si.bus(N), init) : ro.interleave(N, 2) : par(i, N, select2(first))
         : (si.bus(N) <: si.bus(N), stepB)
         : route(2 * N + 1, 2 * N + 1, par(i, N, (i + 1, 2 * i + 1), (N + 2 + i, 2 * i + 2)), (N + 1, 2 * N + 1))
         : (par(i, N, select2(clk)), _);
};

whitenoise(seed) = frand2(seed);
clipnoise(seed) = fcoin(seed);
// GrayNoise: flip one random bit of a 32-bit counter
graynoise_clk(seed, clk) = machine(1, \(c).(float(c2) * 4.65661287308e-10, c2 with { c2 = c xor (1 << (trand(seed) & 31)); }), 0, 1, clk);
// BrownNoise: z += frand8, folded into ±1; starts at frand2, no constructor step
brownnoise_clk(seed, clk) = machine(1, \(z).(z3, z3 with { z2 = z + frand8(seed); z3 = select2(z2 > 1, select2(z2 < -1, z2, -2 - z2), 2 - z2); }),
                                    frand2(seed + 1), 0, clk);
// Dust / Dust2: frand below density * sampledur. density is read once per block.
dust(seed, density, sdur) = select2(z < th, 0.0, z * select2(th > 0, 0.0, 1.0 / th))
with { z = frand(seed); th = a2k(density) * sdur; };
dust2(seed, density, sdur) = select2(z < th, 0.0, z * select2(th > 0, 0.0, 2.0 / th) - 1.0)
with { z = frand(seed); th = a2k(density) * sdur; };

// LFNoise0/1/2: a new random level every SR / freq samples (freq read per block).
nseg(freq, sr, minlen) = max(minlen, int(sr / max(a2k(freq), 0.001)));
lfnoise0_clk(seed, freq, sr, clk) = machine(2, step, (0, 0.0), 1, clk)
with {
    step = \(c, lv).(select2(c <= 0, lv, frand2(seed)),
                     select2(c <= 0, c, nseg(freq, sr, 1)) - 1,
                     select2(c <= 0, lv, frand2(seed)));
};
lfnoise1_clk(seed, freq, sr, clk) = machine(3, step, (0, frand2(seed + 1), 0.0), 1, clk)
with {
    step = \(c, lv, sl).(lv,
                         c2 - 1,
                         lv + sl2,
                         sl2
                         with { re = c <= 0; c2 = select2(re, c, nseg(freq, sr, 1));
                                sl2 = select2(re, sl, (frand2(seed) - lv) / float(c2)); });
};
lfnoise2_clk(seed, freq, sr, clk) = machine(6, step, (0, 0.0, 0.0, 0.0, frand2(seed + 1), frand2(seed + 1) * 0.5), 1, clk)
with {
    // state: counter, level, slope, curve, nextvalue, nextmidpt
    step = \(c, lv, sl, cu, nv, nm).(lv2, c2 - 1, lv2 + sl3, sl3, cu2, nv2, nm2
        with {
            re = c <= 0;
            nv2 = select2(re, nv, frand2(seed));
            lv2 = select2(re, lv, nm);
            nm2 = select2(re, nm, (nv2 + nv) * 0.5);
            c2 = select2(re, c, nseg(freq, sr, 2));
            n = float(c2);
            cu2 = select2(re, cu, 2.0 * (nm2 - lv2 - n * sl) / (n * n + n));
            sl3 = sl + cu2;
        });
};

// PinkNoise: Voss-McCartney with 16 dice; the die is chosen by the trailing zeros of a
// random word (Magnus Jonsson). Output bits (total + rand) | 0x40000000 read as a float.
ctz(x) = sum(j, 31, (x & ((1 << (j + 1)) - 1)) == 0);
pinkout(v) = select2(v < 8388608, 1.0 + float(v - 8388608) / 2097152.0, float(v) / 4194304.0 - 1.0);
pinknoise_clk(seed, clk) = machine(17, step, (initdice, inittotal), 1, clk)
with {
    initdice = lsr(trand(seed * 31 + 101), 13), lsr(trand(seed * 31 + 102), 13), lsr(trand(seed * 31 + 103), 13), lsr(trand(seed * 31 + 104), 13), lsr(trand(seed * 31 + 105), 13), lsr(trand(seed * 31 + 106), 13), lsr(trand(seed * 31 + 107), 13), lsr(trand(seed * 31 + 108), 13), lsr(trand(seed * 31 + 109), 13), lsr(trand(seed * 31 + 110), 13), lsr(trand(seed * 31 + 111), 13), lsr(trand(seed * 31 + 112), 13), lsr(trand(seed * 31 + 113), 13), lsr(trand(seed * 31 + 114), 13), lsr(trand(seed * 31 + 115), 13), lsr(trand(seed * 31 + 116), 13);
    inittotal = initdice :> _;
    step = \(d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, tot).(pinkout(tot2 + lsr(trand(seed + 1), 13)), select2(k == 0, d0, nr), select2(k == 1, d1, nr), select2(k == 2, d2, nr), select2(k == 3, d3, nr), select2(k == 4, d4, nr), select2(k == 5, d5, nr), select2(k == 6, d6, nr), select2(k == 7, d7, nr), select2(k == 8, d8, nr), select2(k == 9, d9, nr), select2(k == 10, d10, nr), select2(k == 11, d11, nr), select2(k == 12, d12, nr), select2(k == 13, d13, nr), select2(k == 14, d14, nr), select2(k == 15, d15, nr), tot2
        with {
            counter = trand(seed);
            nr = lsr(counter, 13);
            k = ctz(counter) & 15;
            tot2 = tot + nr - ba.selectn(16, k, d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15);
        });
};
